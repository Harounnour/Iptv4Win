<Application x:Class="Iptv4Win.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Application.Resources>
    <DrawingImage x:Key="AppIcon">
      <DrawingImage.Drawing>
        <DrawingGroup>
          <GeometryDrawing Brush="#173B78" Geometry="M 16,2 L 30,10 L 30,26 L 16,34 L 2,26 L 2,10 Z"/>
          <GeometryDrawing Brush="#62A8FF" Geometry="M 16,4 L 28,11 L 16,18 L 4,11 Z"/>
          <GeometryDrawing Brush="#2867C7" Geometry="M 4,13 L 15,20 L 15,32 L 4,25 Z"/>
          <GeometryDrawing Brush="#17458E" Geometry="M 17,20 L 28,13 L 28,25 L 17,32 Z"/>
          <GeometryDrawing Brush="#EAF4FF" Geometry="M 16,8 L 20,11 L 16,14 L 12,11 Z"/>
        </DrawingGroup>
      </DrawingImage.Drawing>
    </DrawingImage>
    <SolidColorBrush x:Key="Bg" Color="#0F1218"/>
    <SolidColorBrush x:Key="Panel" Color="#131822"/>
    <SolidColorBrush x:Key="Card" Color="#1A212D"/>
    <SolidColorBrush x:Key="Sel" Color="#1F2A3C"/>
    <SolidColorBrush x:Key="Accent" Color="#3D8BFD"/>
    <SolidColorBrush x:Key="Fg" Color="#E8ECF3"/>
    <SolidColorBrush x:Key="Muted" Color="#9AA4B5"/>

    <Style TargetType="ListBoxItem">
      <Setter Property="Foreground" Value="{StaticResource Fg}"/>
      <Setter Property="Padding" Value="10,0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}" CornerRadius="8" Margin="6,2">
              <ContentPresenter VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#18202C"/>
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Sel}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="Button">
      <Setter Property="Background" Value="{StaticResource Card}"/>
      <Setter Property="Foreground" Value="{StaticResource Fg}"/>
      <Setter Property="Padding" Value="16,9"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="TextBox">
      <Setter Property="Background" Value="#0F1218"/>
      <Setter Property="Foreground" Value="{StaticResource Fg}"/>
      <Setter Property="CaretBrush" Value="{StaticResource Fg}"/>
      <Setter Property="BorderBrush" Value="#2B3547"/>
      <Setter Property="Padding" Value="8,7"/>
    </Style>
    <Style TargetType="PasswordBox">
      <Setter Property="Background" Value="#0F1218"/>
      <Setter Property="Foreground" Value="{StaticResource Fg}"/>
      <Setter Property="CaretBrush" Value="{StaticResource Fg}"/>
      <Setter Property="BorderBrush" Value="#2B3547"/>
      <Setter Property="Padding" Value="8,7"/>
    </Style>
    <Style TargetType="RadioButton">
      <Setter Property="Foreground" Value="{StaticResource Fg}"/>
      <Setter Property="Margin" Value="0,0,18,0"/>
    </Style>
  </Application.Resources>
</Application>
